DirectoryIndex index.php
Options -Indexes
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Consolidate all public URLs on HTTPS and the canonical www host.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.megatechzy\.com$ [NC]
RewriteRule ^ https://www.megatechzy.com%{REQUEST_URI} [R=301,L,NE]

# Keep intentionally retired pages gone even when a hosting upload leaves old
# physical files behind. Remove a slug here when its replacement is approved.
RewriteRule ^(?:portfolio|case-studies)(?:/.*)?$ - [R=410,L,NC]
RewriteRule ^(?:feed|comments/feed)/?$ - [R=410,L,NC]
RewriteRule ^blog/(?:ai-tools-seo-research-content-planning|ecommerce-product-page-seo-checklist|reduce-cost-per-lead-google-ads|what-is-whatsapp-automation)/?$ - [R=410,L,NC]

# Remove a historical WordPress search placeholder without allowing the
# template token to remain as an indexable homepage query variant.
RewriteCond %{QUERY_STRING} (^|&)s=(?:%7Bsearch_term_string%7D|\{search_term_string\})(?:&|$) [NC]
RewriteRule ^$ / [R=301,L,NE,QSD]

# Redirect retired URLs to their closest current equivalent.
RewriteRule ^contact-us(?:\.php)?/?$ /contact [R=301,L,NE,NC]
RewriteRule ^our-services(?:\.php)?/?$ /services/ [R=301,L,NE,NC]
RewriteRule ^locations/pimpri-chinchwad(?:\.php)?/?$ /locations/pcmc [R=301,L,NE,NC]
RewriteRule ^locations/aurangabad(?:\.php)?/?$ /locations/chhatrapati-sambhajinagar [R=301,L,NE,NC]
RewriteRule ^locations/osmanabad(?:\.php)?/?$ /locations/dharashiv [R=301,L,NE,NC]
RewriteRule ^locations/ahmednagar(?:\.php)?/?$ /locations/ahilyanagar [R=301,L,NE,NC]
RewriteRule ^locations/(?:baner|hinjawadi|chakan|talegaon)(?:\.php)?/?$ /locations/pune [R=301,L,NE,NC]
RewriteRule ^locations/(?:wakad|bhosari|chinchwad|moshi|nigdi|pimpri)(?:\.php)?/?$ /locations/pcmc [R=301,L,NE,NC]
RewriteRule ^blog/old-seo-guide/?$ /blog/technical-seo-checklist-new-website [R=301,L,NE]

# Use extensionless, non-trailing-slash canonicals for public page routes.
# Real directories such as /blog/, /services/ and /locations/ keep the slash.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

# Keep public page URLs extensionless. The form API remains a PHP endpoint.
RewriteCond %{REQUEST_URI} !^/api/ [NC]
RewriteCond %{THE_REQUEST} \s/+index\.php(?:[\s?]|$) [NC]
RewriteRule ^index\.php$ / [R=301,L]

RewriteCond %{REQUEST_URI} !^/api/ [NC]
RewriteCond %{THE_REQUEST} \s/+.+\.php(?:[\s?]|$) [NC]
RewriteRule ^(.+)\.php$ /$1 [R=301,L,NE]

# Serve clean city URLs from one validated location controller. Existing
# location wrapper files continue to redirect to the same canonical URLs.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^locations/([a-z0-9-]+)/?$ locations/city.php?location=$1 [L,QSA,NC]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set X-XSS-Protection "0"
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "\.(css|js|png|jpe?g|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
